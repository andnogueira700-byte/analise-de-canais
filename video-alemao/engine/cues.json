[802.306, 803.559, "A língua que foi proibida"], [803.606, 804.674, "virou patrimônio."], [804.825, 806.044, "Mas não está tudo ganho."], [806.068, 808.076, "Os próprios pesquisadores avisam que"], [808.123, 809.539, "os jovens falam cada vez"], [809.62, 810.05, "menos."], [810.224, 810.642, "Por isso,"], [810.665, 812.488, "ainda existe tanta gente trabalhando"], [812.546, 813.719, "para a língua não sumir."], [813.893, 814.218, "Então,"], [814.253, 815.878, "como o alemão sobreviveu no"], [815.948, 816.981, "Sul do Brasil?"], [817.03, 818.237, "Porque ele estava em toda"], [818.284, 818.702, "parte."], [818.783, 819.491, "Na escola,"], [819.573, 820.258, "na igreja,"], [820.339, 821.755, "no clube e no jornal."], [821.871, 821.987, "E,"], [822.034, 823.508, "quando tudo isso foi proibido,"], [823.532, 825.192, "sobrou o que ninguém consegue"], [825.238, 826.283, "tirar de uma família."], [826.399, 827.607, "A língua de casa."], [827.758, 828.164, "No fim,"], [828.187, 829.406, "o que salvou o alemão"], [829.615, 830.52, "não foi uma lei,"], [830.648, 831.368, "nem um livro."], [831.496, 832.506, "Foi gente comum,"], [832.622, 834.015, "que continuou conversando com os"], [834.085, 834.398, "filhos."], [834.421, 835.315, "Se você gostou,"], [835.466, 836.859, "se inscreva no canal para"], [836.941, 838.624, "não perder os próximos mapas."], [838.798, 839.588, "No próximo vídeo,"], [839.623, 840.795, "vamos para o outro lado"], [840.842, 841.19, "do mundo."], [841.213, 841.689, "Macau,"], [841.805, 843.721, "Goa e Timor-Leste,"], [843.837, 845.021, "e o português que quase"], [845.068, 845.683, "sumiu."], [845.712, 846.815, "Porque a raiz de tudo"], [846.838, 847.848, "está no mapa."]]