[[0.0, 1.498, "Quando um governo proíbe uma"], [1.567, 1.962, "língua,"], [1.997, 3.007, "ela costuma morrer."], [3.181, 4.307, "É assim que quase sempre"], [4.331, 4.934, "acontece."], [5.108, 5.608, "No Brasil,"], [5.631, 6.687, "o alemão foi proibido de"], [6.734, 7.303, "verdade."], [7.477, 8.754, "Foi proibido na escola,"], [8.847, 9.868, "no jornal e até na"], [9.903, 10.321, "rua."], [10.53, 11.68, "Gente foi presa só por"], [11.714, 12.736, "conversar num café."], [12.829, 13.746, "Eu sempre achei que uma"], [13.781, 15.708, "proibição dessas acabava com qualquer"], [15.777, 16.219, "língua."], [16.428, 17.682, "E ela deixou marcas bem"], [17.751, 18.308, "fundas."], [18.459, 19.377, "Mas descobri que,"], [19.446, 20.99, "quase noventa anos depois,"], [21.141, 22.012, "mais de um milhão de"], [22.058, 24.206, "pessoas ainda falam alemão no"], [24.264, 25.054, "Sul do Brasil."], [25.298, 26.122, "Não é o alemão da"], [26.145, 26.935, "Alemanha."], [26.984, 28.133, "É um alemão que nasceu"], [28.168, 28.447, "aqui,"], [28.528, 29.527, "dentro das casas,"], [29.55, 30.966, "e que ninguém conseguiu calar."], [31.175, 32.476, "Como isso foi possível?"], [32.65, 33.404, "Para entender,"], [33.428, 34.844, "a gente precisa voltar ao"], [34.96, 36.284, "ano de mil oitocentos e"], [36.342, 37.166, "vinte e quatro."], [37.445, 38.362, "No dia vinte e cinco"], [38.408, 39.813, "de julho de mil oitocentos"], [39.871, 40.742, "e vinte e quatro,"], [40.986, 42.739, "trinta e nove alemães chegaram"], [42.832, 44.26, "a um lugar chamado São"], [44.294, 44.956, "Leopoldo."], [45.049, 46.256, "Ficava no Rio Grande do"], [46.303, 46.582, "Sul."], [46.732, 47.928, "Eram gente simples."], [47.96, 49.423, "Vinham de uma região pobre"], [49.458, 51.095, "chamada Hunsrúque,"], [51.246, 52.43, "no oeste da Alemanha."], [52.755, 53.962, "A cidade ganhou o nome"], [54.009, 55.82, "da imperatriz Leopoldina,"], [55.936, 57.666, "mulher do imperador Dom Pedro"], [57.712, 58.293, "Primeiro."], [58.467, 59.767, "Os trinta e nove ficaram"], [59.791, 61.323, "numa antiga fazenda do governo,"], [61.346, 62.868, "a Feitoria do Linho Cânhamo,"], [63.018, 64.354, "até receberem um pedaço de"], [64.435, 64.853, "terra."], [65.027, 66.339, "Eles saíram de navio do"], [66.409, 67.372, "porto de Hamburgo."], [67.488, 67.906, "Depois,"], [67.929, 69.16, "subiram o rio de barco"], [69.195, 70.24, "até o lugar onde iam"], [70.275, 70.681, "morar."], [70.89, 72.573, "Chegaram cheios de promessas."], [72.62, 73.061, "Terra,"], [73.096, 73.816, "ferramentas,"], [73.874, 76.173, "comida no começo e liberdade"], [76.219, 77.601, "para rezar do jeito deles."], [77.752, 79.075, "Mas muita coisa que prometeram"], [79.11, 79.621, "não veio."], [79.865, 81.049, "Cada família teve que se"], [81.095, 82.082, "virar sozinha."], [82.21, 83.533, "E eles não ficaram sozinhos"], [83.591, 84.451, "por muito tempo."], [84.601, 86.215, "Entre mil oitocentos e vinte"], [86.239, 87.887, "e quatro e mil oitocentos"], [87.945, 88.503, "e trinta,"], [88.676, 90.14, "mais de cinco mil alemães"], [90.198, 91.51, "desembarcaram no Brasil."], [91.719, 92.996, "A maioria foi para perto"], [93.042, 93.959, "de São Leopoldo."], [94.075, 95.329, "Eles não falavam português."], [95.445, 96.258, "A língua do dia a"], [96.328, 97.407, "dia era o alemão,"], [97.431, 98.394, "porque era a única que"], [98.429, 99.103, "eles sabiam."], [99.312, 99.857, "Mas isso,"], [99.88, 100.322, "sozinho,"], [100.356, 101.506, "não explica nada."], [101.538, 103.036, "Muita gente troca de língua"], [103.059, 103.883, "em poucos anos."], [103.999, 105.207, "Para entender por que eles"], [105.265, 105.88, "não trocaram,"], [105.903, 107.773, "precisamos ver onde essas famílias"], [107.842, 108.481, "foram morar."], [108.806, 110.373, "Quando o imigrante chegava,"], [110.489, 112.289, "o governo entregava um pedaço"], [112.324, 113.229, "de terra no meio do"], [113.276, 113.659, "mato."], [113.833, 114.587, "Muitas vezes,"], [114.622, 116.155, "a cidade mais próxima ficava"], [116.201, 116.689, "longe,"], [116.747, 117.745, "e o caminho era só"], [117.78, 118.558, "uma picada."], [118.732, 120.439, "Os vizinhos eram outras famílias"], [120.497, 121.101, "alemãs."], [121.31, 122.981, "As colônias foram feitas para"], [123.028, 124.723, "juntar gente da mesma origem."], [124.897, 126.615, "Foi assim em São Leopoldo."], [126.642, 128.453, "Depois foi assim em Blumenau,"], [128.604, 130.589, "em mil oitocentos e cinquenta,"], [130.764, 131.832, "e em Joinville,"], [132.006, 133.98, "em mil oitocentos e cinquenta"], [134.014, 134.409, "e um."], [134.734, 136.58, "Em mil oitocentos e setenta"], [136.615, 137.3, "e seis,"], [137.451, 139.192, "a colônia de Blumenau tinha"], [139.262, 141.085, "mais de dez mil moradores."], [141.41, 142.71, "Mais de oito mil eram"], [142.78, 143.418, "alemães."], [143.627, 144.579, "Em Joinville,"], [144.695, 146.483, "chegaram cerca de dezessete mil"], [146.518, 148.887, "imigrantes entre mil oitocentos e"], [148.933, 150.721, "cinquenta e mil oitocentos e"], [150.767, 151.708, "oitenta e oito,"], [151.824, 153.542, "boa parte deles alemães."], [153.67, 154.796, "Imagine viver ali."], [154.912, 156.642, "O vizinho falava alemão."], [156.758, 158.349, "O dono do armazém falava"], [158.476, 159.103, "alemão."], [159.219, 160.496, "O padeiro também."], [160.523, 161.847, "Para que aprender português,"], [161.963, 163.437, "se você quase nunca precisava"], [163.484, 163.82, "dele?"], [163.936, 165.713, "Com os pomeranos foi parecido."], [165.829, 167.234, "Eles moravam em colônias só"], [167.303, 167.652, "deles,"], [167.675, 168.626, "no Espírito Santo,"], [168.65, 169.648, "em Santa Catarina e no"], [169.683, 170.542, "Rio Grande do Sul."], [170.717, 172.028, "E falavam a língua deles"], [172.098, 172.899, "o dia inteiro."], [173.05, 174.547, "Esse isolamento foi a segunda"], [174.582, 175.058, "razão."], [175.232, 176.44, "A língua vivia porque a"], [176.498, 178.367, "vida inteira acontecia dentro dela."], [178.518, 180.027, "Mas ainda faltava uma peça"], [180.051, 180.898, "importante,"], [180.956, 182.233, "e ela veio das escolas."], [182.407, 183.917, "A terceira razão vem de"], [183.975, 185.136, "uma coisa que o governo"], [185.194, 185.925, "não fez."], [185.966, 186.883, "Naquela época,"], [186.999, 188.822, "quase não existia escola pública"], [188.903, 189.762, "nas colônias."], [189.879, 191.841, "Então os próprios imigrantes resolveram"], [191.864, 192.479, "o problema."], [192.595, 193.512, "Eles se juntavam,"], [193.547, 195.184, "pagavam um professor e construíam"], [195.219, 195.811, "a escola."], [195.927, 197.007, "Em muitas colônias,"], [197.123, 198.969, "uma associação de pais cuidava"], [199.015, 199.561, "de tudo."], [199.712, 200.293, "Na Alemanha,"], [200.327, 202.022, "estudar era obrigação."], [202.231, 203.3, "E eles não queriam que"], [203.346, 205.053, "os filhos crescessem sem saber"], [205.169, 206.132, "ler e escrever."], [206.411, 207.166, "Em Blumenau,"], [207.317, 209.105, "em mil oitocentos e sessenta"], [209.139, 209.697, "e sete,"], [209.813, 211.009, "a colônia já tinha doze"], [211.032, 211.601, "escolas,"], [211.717, 213.145, "com duzentas e sessenta e"], [213.203, 214.201, "três crianças."], [214.23, 215.414, "Isso menos de vinte anos"], [215.461, 216.529, "depois da fundação."], [216.703, 217.365, "Com o tempo,"], [217.4, 218.688, "o número cresceu muito."], [218.839, 220.627, "O historiador Lúcio Króits,"], [220.801, 222.125, "que estudou esse assunto por"], [222.183, 222.415, "anos,"], [222.461, 223.541, "fala em cerca de mil"], [223.576, 224.911, "e quinhentas escolas alemãs no"], [224.946, 225.434, "Brasil."], [225.712, 226.525, "É mais do que em"], [226.583, 227.919, "qualquer outro país da América"], [227.953, 228.406, "Latina."], [228.522, 229.312, "Nessas escolas,"], [229.347, 230.763, "a criança aprendia a ler,"], [230.937, 232.052, "a contar e a rezar"], [232.087, 232.597, "em alemão."], [232.748, 233.898, "A escola mantinha a língua"], [233.967, 234.443, "viva."], [234.525, 235.326, "E ela nem era do"], [235.361, 235.79, "governo."], [235.813, 237.172, "Era da própria comunidade."], [237.288, 238.507, "Mas a escola não trabalhava"], [238.542, 239.215, "sozinha."], [239.255, 240.161, "Ao lado dela,"], [240.207, 241.101, "quase sempre,"], [241.136, 242.25, "ficava a igreja."], [242.378, 243.969, "Dos trinta e nove primeiros"], [244.038, 244.596, "imigrantes,"], [244.642, 246.337, "trinta e três eram luteranos"], [246.418, 247.835, "e seis eram católicos."], [248.16, 249.808, "Os dois grupos tinham pastores"], [249.878, 251.515, "e padres que falavam alemão."], [251.689, 252.235, "O culto,"], [252.258, 253.605, "a pregação e os cantos"], [253.663, 254.545, "eram em alemão."], [254.72, 255.474, "Muitas vezes,"], [255.52, 256.995, "quem cuidava da igreja também"], [257.03, 258.052, "cuidava da escola."], [258.203, 259.259, "Em Itapiranga,"], [259.282, 260.327, "em Santa Catarina,"], [260.443, 261.86, "o povo lia uma revista"], [261.918, 263.415, "da igreja escrita em alemão."], [263.532, 264.565, "E a missa também era"], [264.6, 265.169, "em alemão."], [265.285, 266.411, "Então veja o tamanho da"], [266.48, 267.328, "força disso."], [267.444, 268.779, "A criança ouvia alemão em"], [268.849, 269.58, "casa."], [269.609, 271.06, "Aprendia alemão na escola."], [271.118, 272.442, "E rezava em alemão no"], [272.488, 272.988, "domingo."], [273.138, 274.253, "A língua estava em três"], [274.299, 275.495, "lugares ao mesmo tempo."], [275.611, 276.888, "É difícil esquecer uma coisa"], [276.923, 278.015, "que você usa de manhã,"], [278.049, 279.083, "à tarde e na hora"], [279.118, 279.617, "de rezar."], [279.71, 280.789, "Eu achava que o segredo"], [280.836, 281.904, "era só teimosia."], [282.032, 283.936, "Mas a língua sobreviveu porque"], [283.971, 285.051, "era útil em tudo."], [285.26, 286.27, "Só que a vida deles"], [286.316, 287.373, "não era só trabalho e"], [287.431, 287.907, "reza."], [288.116, 289.277, "E é aí que entram"], [289.3, 290.565, "os clubes e os jornais."], [290.682, 292.98, "Os colonos copiaram da Alemanha"], [293.131, 294.571, "uma coisa que eles amavam."], [294.745, 295.894, "As sociedades."], [295.94, 297.089, "Eram clubes de canto,"], [297.113, 297.635, "de tiro,"], [297.67, 299.504, "de ginástica e de teatro."], [299.678, 300.851, "Era ali que o povo"], [300.897, 302.662, "se encontrava para se divertir."], [302.836, 303.475, "Cantava,"], [303.51, 305.147, "atirava no alvo e fazia"], [305.193, 305.727, "teatro."], [305.901, 307.26, "E tudo isso acontecia em"], [307.329, 307.84, "alemão."], [308.014, 308.781, "Em Joinville,"], [308.815, 310.917, "em mil oitocentos e setenta"], [310.94, 311.509, "e sete,"], [311.718, 313.494, "já existiam muitos desses clubes,"], [313.668, 314.667, "além de escola,"], [314.795, 315.433, "igreja,"], [315.456, 317.442, "hospital e corpo de bombeiros."], [317.593, 319.508, "Era uma cidade inteira funcionando"], [319.566, 320.785, "do jeito dos países de"], [320.832, 321.563, "onde eles vieram."], [321.679, 322.921, "Tinha jornal também."], [322.951, 324.518, "A primeira cartilha alemã que"], [324.565, 325.656, "se conhece no Brasil foi"], [325.679, 327.734, "impressa em mil oitocentos e"], [327.804, 328.593, "trinta e dois."], [328.768, 329.905, "Isso foi só oito anos"], [329.94, 331.415, "depois da chegada dos primeiros"], [331.473, 331.949, "colonos."], [332.123, 333.597, "A partir de mil oitocentos"], [333.667, 334.282, "e cinquenta,"], [334.364, 335.49, "aparecem jornais,"], [335.525, 337.092, "almanaques e livros em alemão,"], [337.15, 338.451, "feitos aqui no Rio Grande"], [338.509, 338.938, "do Sul."], [339.263, 340.343, "O colono podia ler as"], [340.401, 341.086, "notícias,"], [341.121, 342.375, "aprender a plantar melhor e"], [342.41, 343.095, "se divertir,"], [343.153, 344.314, "sem sair do alemão."], [344.523, 345.126, "Escola,"], [345.184, 345.765, "igreja,"], [345.834, 346.868, "clube e jornal."], [347.112, 348.679, "Parecia uma língua impossível de"], [348.737, 349.468, "derrubar."], [349.518, 351.259, "Mas todas essas coisas tinham"], [351.283, 352.537, "o mesmo ponto fraco."], [352.629, 353.941, "Podiam ser fechadas por uma"], [353.988, 354.29, "lei."], [354.359, 355.602, "E foi o que aconteceu."], [355.753, 357.111, "Tudo isso mudou em mil"], [357.146, 359.224, "novecentos e trinta e sete."], [359.398, 360.025, "Naquele ano,"], [360.071, 361.662, "o presidente Getúlio Vargas deu"], [361.685, 363.287, "um golpe e virou ditador."], [363.531, 364.878, "Ele queria um Brasil com"], [364.901, 365.807, "um só jeito e uma"], [365.841, 366.387, "só língua."], [366.538, 368.547, "O governo olhou com desconfiança"], [368.593, 369.859, "para as colônias do Sul."], [370.033, 370.335, "Ali,"], [370.358, 371.913, "muita gente falava alemão e"], [372.006, 373.353, "mal falava português."], [373.504, 374.212, "Para o governo,"], [374.235, 375.663, "isso parecia uma ameaça."], [375.814, 377.196, "Isso não era novidade."], [377.234, 378.941, "Já em mil novecentos e"], [378.999, 379.777, "dezessete,"], [379.893, 381.808, "Santa Catarina mandou as escolas"], [381.878, 383.759, "estrangeiras ensinarem português."], [383.91, 385.222, "Mas agora o governo ia"], [385.291, 386.336, "muito mais longe."], [386.51, 388.147, "Em maio de mil novecentos"], [388.205, 388.995, "e trinta e oito,"], [389.03, 390.957, "saiu a lei número quatrocentos"], [391.015, 391.503, "e seis."], [391.781, 392.989, "Ela mandava as escolas do"], [393.047, 394.916, "campo ensinarem tudo em português."], [394.997, 396.449, "Os professores tinham que ser"], [396.507, 397.946, "brasileiros de nascença."], [397.975, 398.73, "E livros,"], [398.904, 400.785, "revistas e jornais em língua"], [400.808, 401.539, "estrangeira,"], [401.655, 402.294, "no campo,"], [402.422, 404.035, "só com licença do governo."], [404.21, 405.823, "Em mil novecentos e trinta"], [405.847, 407.426, "e nove vieram outras leis,"], [407.46, 408.412, "ainda mais duras."], [408.587, 410.107, "As escolas que não obedeciam"], [410.165, 410.943, "foram fechadas."], [410.978, 412.209, "Os livros em alemão foram"], [412.244, 412.824, "recolhidos."], [412.917, 414.194, "Chamaram isso de campanha de"], [414.264, 415.274, "nacionalização."], [415.483, 416.087, "Na prática,"], [416.11, 417.317, "era obrigar todo mundo a"], [417.364, 418.339, "falar só português."], [418.455, 419.407, "Para muitos pais,"], [419.442, 420.533, "foi como ver tudo o"], [420.591, 422.031, "que construíram desmoronar."], [422.159, 423.145, "E isso ainda era só"], [423.169, 423.981, "o começo."], [424.019, 425.853, "Em mil novecentos e quarenta"], [425.877, 426.376, "e dois,"], [426.492, 427.943, "o clima ficou muito pior."], [428.117, 429.708, "Em janeiro de mil novecentos"], [429.754, 430.486, "e quarenta e dois,"], [430.509, 432.111, "o Brasil rompeu relações com"], [432.146, 432.75, "a Alemanha."], [433.075, 434.282, "Em agosto daquele ano,"], [434.305, 436.802, "submarinos alemães afundaram seis navios"], [436.86, 438.845, "brasileiros em apenas cinco dias."], [439.089, 440.319, "Muita gente morreu."], [440.47, 441.295, "O povo foi para a"], [441.318, 441.62, "rua,"], [441.643, 442.595, "cheio de raiva."], [442.804, 443.93, "No dia vinte e dois"], [443.965, 444.627, "de agosto,"], [444.743, 446.055, "o Brasil declarou guerra à"], [446.113, 446.682, "Alemanha."], [446.856, 448.261, "E quem falava alemão virou"], [448.33, 448.725, "alvo."], [448.934, 450.2, "Mesmo quem não tinha nada"], [450.223, 451.465, "a ver com o nazismo."], [451.5, 452.951, "Havia gente ligada ao partido"], [452.986, 453.404, "nazista,"], [453.439, 454.635, "mas era uma minoria."], [454.762, 456.446, "A maioria era gente comum,"], [456.492, 457.769, "que só queria trabalhar."], [457.978, 459.348, "Passou a ser proibido falar"], [459.395, 460.498, "alemão em público."], [460.742, 461.972, "Quem tinha nascido na Alemanha"], [462.019, 463.18, "precisava de um papel da"], [463.226, 463.656, "polícia,"], [463.679, 464.678, "o salvo-conduto,"], [464.794, 465.92, "até para viajar de uma"], [465.943, 467.0, "cidade para outra."], [467.174, 468.137, "Em alguns estados,"], [468.161, 469.461, "a ordem chegava a proibir"], [469.496, 471.028, "reuniões até dentro de casa,"], [471.052, 472.387, "como festa de aniversário."], [472.596, 474.035, "E muita gente perdeu bens."], [474.209, 475.777, "Teve casa apedrejada,"], [475.893, 477.832, "gente agredida e gente presa."], [477.858, 478.624, "Em Joinville,"], [478.752, 480.377, "um jornal de mil novecentos"], [480.424, 481.724, "e quarenta e três deu"], [481.759, 483.21, "a notícia de pessoas presas"], [483.268, 484.325, "por falar alemão em um"], [484.371, 484.847, "café."], [485.172, 486.716, "Imagine ser punido por falar"], [486.774, 487.866, "a língua da sua mãe."], [488.017, 489.433, "Foi a parte mais pesada"], [489.491, 490.362, "dessa pesquisa."], [490.478, 490.606, "E,"], [490.629, 491.256, "mesmo assim,"], [491.291, 492.324, "a língua não morreu."], [492.498, 493.369, "O motivo é o mais"], [493.427, 494.553, "interessante de todos."], [494.669, 495.656, "Aqui vem a parte que"], [495.679, 496.817, "eu achei mais interessante."], [496.933, 498.698, "O governo podia fechar escola,"], [498.849, 500.892, "recolher livro e parar jornal."], [500.924, 501.644, "Mas como é que se"], [501.702, 502.607, "fecha uma conversa?"], [502.724, 504.233, "O alemão que a maioria"], [504.268, 506.032, "dessas famílias falava não era"], [506.056, 507.031, "o alemão dos livros."], [507.124, 508.169, "Era um jeito de falar"], [508.238, 509.678, "que veio direto da roça,"], [509.759, 511.245, "trazido por quem saiu daquela"], [511.28, 512.197, "região pobre,"], [512.267, 513.022, "Hunsrúque."], [513.138, 513.567, "Por isso,"], [513.602, 514.763, "a língua é chamada de"], [514.844, 515.727, "húnsrik."], [515.901, 517.793, "O estudioso Cléo Altenhôfen,"], [517.886, 519.372, "da Universidade Federal do Rio"], [519.419, 520.138, "Grande do Sul,"], [520.231, 521.938, "pesquisa o húnsrik há muitos"], [522.008, 522.426, "anos."], [522.577, 523.761, "Ele mostra que essa língua"], [523.784, 523.83, "é,"], [523.865, 524.573, "principalmente,"], [524.608, 525.166, "falada."], [525.258, 526.443, "Quase ninguém escrevia."], [526.524, 527.662, "Era língua de casa,"], [527.685, 529.252, "de cozinha e de lavoura."], [529.293, 530.454, "Aprendia-se com a mãe,"], [530.477, 531.557, "e não na escola."], [531.731, 532.822, "E isso fez toda a"], [532.88, 533.624, "diferença."], [533.74, 534.924, "E essa língua não ficou"], [534.959, 535.528, "parada."], [535.644, 537.176, "Ela pegou palavras do português"], [537.246, 538.825, "para nomear coisas novas que"], [538.848, 539.719, "existiam aqui."], [539.928, 540.357, "Por isso,"], [540.415, 541.971, "o húnsrik de hoje não"], [542.029, 543.225, "é igual ao alemão da"], [543.248, 543.817, "Europa."], [543.945, 545.384, "É um alemão feito aqui."], [545.593, 547.021, "A lei atingiu o que"], [547.056, 548.531, "era escrito e organizado."], [548.554, 549.216, "Escola,"], [549.332, 549.785, "livro,"], [549.866, 550.423, "jornal."], [550.748, 552.211, "Mas a conversa da mãe"], [552.246, 552.908, "com o filho,"], [552.931, 553.558, "no fogão,"], [553.686, 555.369, "ficou escondida onde o guarda"], [555.415, 556.205, "não chegava."], [556.53, 558.434, "A proibição derrubou a escola."], [558.608, 559.816, "Mas a língua estava em"], [559.932, 560.919, "outro lugar."], [560.953, 562.114, "Estava dentro de casa."], [562.149, 563.31, "Claro que muita gente teve"], [563.356, 563.763, "medo."], [563.879, 565.353, "Mas muita gente também deu"], [565.376, 565.934, "um jeito."], [566.085, 566.944, "Dentro de casa,"], [566.967, 568.941, "as famílias continuaram falando alemão,"], [568.975, 570.357, "só que mais baixo e"], [570.404, 571.518, "de portas fechadas."], [571.669, 572.702, "Na rua e no comércio,"], [572.818, 574.328, "usavam o pouco de português"], [574.374, 575.025, "que sabiam."], [575.141, 577.009, "Alguns professores também resistiram."], [577.184, 578.542, "Um estudo sobre o Vale"], [578.589, 579.32, "do Taquari,"], [579.471, 580.493, "no Rio Grande do Sul,"], [580.528, 581.991, "achou uma notícia de mil"], [582.025, 583.616, "novecentos e quarenta."], [583.653, 584.791, "Ela falava de um professor"], [584.826, 586.033, "que ainda ensinava os alunos"], [586.079, 586.625, "em alemão,"], [586.799, 588.727, "mesmo depois das novas regras."], [588.854, 589.621, "O pior é que o"], [589.713, 590.758, "medo não vinha só de"], [590.828, 591.234, "fora."], [591.408, 592.244, "Em Itapiranga,"], [592.279, 593.881, "os pesquisadores contam que,"], [593.905, 594.23, "antes,"], [594.253, 595.576, "o povo era unido."], [595.751, 596.203, "Depois,"], [596.238, 597.817, "passou a reinar a desconfiança,"], [597.841, 599.478, "porque quem denunciava era gente"], [599.524, 600.383, "do próprio grupo."], [600.557, 602.09, "Muita criança aprendeu português na"], [602.148, 602.578, "marra."], [602.752, 603.785, "Uma senhora contou,"], [603.82, 604.528, "anos depois,"], [604.609, 606.339, "que mil novecentos e trinta"], [606.362, 607.303, "e oito foi um ano"], [607.349, 608.266, "muito triste."], [608.313, 609.753, "Ela não podia falar alemão"], [609.811, 611.239, "e ainda não sabia português."], [611.39, 611.703, "Assim,"], [611.726, 613.247, "a língua passou aquele tempo"], [613.27, 613.967, "escondida,"], [614.083, 614.733, "mas viva."], [614.977, 616.057, "Só que ela saiu dali"], [616.115, 616.788, "machucada."], [616.939, 618.39, "A guerra acabou em mil"], [618.414, 620.306, "novecentos e quarenta e cinco,"], [620.422, 621.363, "mas o medo ficou."], [621.537, 622.279, "Depois dela,"], [622.303, 624.45, "algumas comunidades tentaram retomar as"], [624.52, 625.704, "escolas e os clubes."], [626.029, 627.283, "Mas já não era como"], [627.306, 627.585, "ante