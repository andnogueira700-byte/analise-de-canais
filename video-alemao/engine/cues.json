898, 687.187, "sofreram preconceito,"], [687.21, 688.197, "por falar uma língua que"], [688.267, 689.904, "quase ninguém escrevia e por"], [689.939, 690.891, "viverem na roça."], [691.169, 692.922, "Pesquisadores dizem que a ditadura"], [692.969, 693.48, "militar,"], [693.538, 695.198, "depois de mil novecentos e"], [695.244, 696.278, "sessenta e quatro,"], [696.429, 697.23, "também pesou."], [697.404, 698.739, "Mas olha o que aconteceu."], [698.913, 699.633, "Na Europa,"], [699.749, 701.003, "o pomerano deixou de ser"], [701.073, 702.675, "falado no lugar de origem,"], [702.698, 704.323, "ainda no século passado."], [704.364, 704.898, "No Brasil,"], [704.933, 705.943, "ele continua vivo."], [706.094, 708.126, "Os estudiosos calculam cerca de"], [708.195, 710.006, "cento e vinte mil descendentes"], [710.25, 712.166, "de pomeranos no Espírito Santo,"], [712.282, 713.71, "e cerca de trezentos mil"], [713.745, 714.349, "no Brasil."], [714.627, 716.055, "Em Santa Maria de Jetibá,"], [716.09, 717.193, "no Espírito Santo,"], [717.321, 719.283, "uma pesquisa da universidade federal"], [719.352, 720.258, "fez uma conta."], [720.374, 721.57, "Oitenta e cinco por cento"], [721.616, 723.52, "dos moradores têm mais facilidade"], [723.578, 724.89, "para falar pomerano."], [725.215, 726.179, "Essa foi a parte que"], [726.26, 727.294, "mais me surpreendeu."], [727.468, 728.698, "Uma língua que quase some"], [728.722, 729.407, "na casa dela,"], [729.43, 730.068, "na Europa,"], [730.138, 731.206, "fica de pé do outro"], [731.253, 732.367, "lado do oceano."], [732.393, 733.902, "E quem salvou foi gente"], [733.972, 734.355, "simples,"], [734.378, 735.377, "que nunca parou de falar"], [735.412, 736.213, "com os filhos e com"], [736.248, 736.863, "os vizinhos."], [736.979, 737.409, "E hoje,"], [737.432, 738.117, "o que sobrou?"], [738.361, 739.22, "Muita coisa."], [739.336, 739.812, "Primeiro,"], [739.835, 740.984, "está na boca do povo,"], [741.042, 742.32, "mesmo de quem não sabe"], 